# ローカル開発用
PORT=4000
JWT_SECRET=change_me_to_a_long_random_string
DB_PATH=./data/quiz.db
UPLOADS_DIR=./uploads
CLIENT_ORIGIN=http://localhost:5173

# 本番(Railway等)では以下のように永続ボリュームのマウント先を指定する:
# DB_PATH=/data/quiz.db
# UPLOADS_DIR=/data/uploads
# CLIENT_ORIGIN=https://<your-app>.up.railway.app (単一サービスで配信する場合は不要)
# PORTはRailwayが自動設定するため通常は設定不要

# 初回起動時、管理者アカウントが1件もなければこの2つの値から自動作成する(CLI不要)
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=change_me_to_a_strong_password
